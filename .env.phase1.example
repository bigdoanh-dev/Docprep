# Local illustration only. setup-phase1.ps1 generates separate random database/Redis credentials.
APP_ENV=dev
PHASE_MODEL_PROVIDER=disabled
OWNER_DB_PASSWORD=replace_with_generated_hex
MIGRATOR_DB_PASSWORD=replace_with_generated_hex
BUSINESS_DB_PASSWORD=replace_with_generated_hex
CHAT_DB_PASSWORD=replace_with_generated_hex
REDIS_PASSWORD=replace_with_generated_hex
GRAFANA_PASSWORD=replace_with_generated_hex
PHASE_HTTP_PORT=18880
SITE_ADDRESS=http://:80
PHASE_POOL_MAX=5
# These are dev/test application limits, NOT GPU capacity estimates.
PHASE_ACTIVE_TURNS=1
PHASE_MAX_WAITING=20
PHASE_QUEUE_SECONDS=60
PHASE_TURN_SECONDS=360
PHASE_MODEL_SLOTS=1
