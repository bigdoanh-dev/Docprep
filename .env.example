# Server-side Vite proxy target. Never put model secrets in the frontend.
BACKEND_URL=http://127.0.0.1:8000

# Local Alpha only. The database and tests are deliberately separate.
APP_ENV=dev
APP_MODE=real
MODEL_PROVIDER=scripted
DATABASE_URL=postgresql://alpha:alpha_local_only@127.0.0.1:15433/alphav1
DATABASE_URL_TEST=postgresql://alpha:alpha_local_only@127.0.0.1:15433/alphav1_test
