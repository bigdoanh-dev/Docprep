{
  "title": "DocPrep Phase 1 local",
  "uid": "docprep-phase1",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id":1,"type":"timeseries","title":"Queued turns (shared DB; max, not sum)","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"max(docprep_ai_queued)","refId":"A"}]},
    {"id":2,"type":"timeseries","title":"Open and quarantined model reservations","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"max(docprep_ai_model_reservations)","refId":"A","legendFormat":"open"},{"expr":"max(docprep_ai_quarantined)","refId":"B","legendFormat":"quarantined"}]},
    {"id":3,"type":"timeseries","title":"p95 response headers seconds (NOT total SSE)","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.95,sum by(le,service)(rate(docprep_http_headers_seconds_bucket[5m])))","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"HTTP 5xx per second","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"sum by(service)(rate(docprep_http_requests_total{status=~\"5..\"}[5m]))","refId":"A"}]},
    {"id":5,"type":"timeseries","title":"Borrowed PostgreSQL connections across processes","gridPos":{"h":8,"w":12,"x":0,"y":16},"targets":[{"expr":"sum(docprep_db_pool_used)","refId":"A"}]},
    {"id":6,"type":"timeseries","title":"p95 queue wait seconds","gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"histogram_quantile(0.95,sum by(le)(rate(docprep_ai_queue_wait_seconds_bucket[5m])))","refId":"A"}]}
  ]
}
