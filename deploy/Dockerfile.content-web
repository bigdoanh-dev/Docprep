FROM node:24-alpine AS build
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY tsconfig*.json vite.config.ts vite.content.config.ts content.html ./
COPY src ./src
RUN npm run build:content
FROM caddy:2.10-alpine
COPY --from=build /web/dist-content /srv/web
COPY deploy/Caddyfile.content /etc/caddy/Caddyfile
