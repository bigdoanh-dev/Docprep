# Chat-only model configuration. Copy to backend/.env; never commit the real file.
YHDP_OLLAMA_URL=http://127.0.0.1:11434
YHDP_LLM_MODEL=qwen3.5:9b-q4_K_M
YHDP_EMBED_MODEL=bge-m3
YHDP_LLM_NUM_CTX=16384
YHDP_OLLAMA_TIMEOUT_SECONDS=300

# Anthropic API key for dev/test only. Leave empty here; put the real key in backend/.env.
ANTHROPIC_API_KEY=
# Hosted generator for dev/test (PHASE_MODEL_PROVIDER=anthropic). Embeddings stay on Ollama.
# From Docker containers use YHDP_OLLAMA_URL=http://host.docker.internal:11434.
YHDP_ANTHROPIC_MODEL=claude-opus-5-5
YHDP_ANTHROPIC_EFFORT=medium
